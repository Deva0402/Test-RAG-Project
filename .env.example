APP_NAME=Healthcare RAG Assistant
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

LLM_BACKEND=llama_cpp
LLM_MODEL_PATH=models/llm/phi3-mini-4k-q4.gguf

LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_N_THREADS=4

#----EMBEDDINGS------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
#------VECTORDB-----
VECTORDB_BACKEND=chroma
VECTORDB_COLLECTION_NAME=medical_docs
CHROMA_PERSIST_DIR=data/vectorstore/chroma
#----RAG PIPELINE----
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_USE_HYBRID_SEARCH=true
RAG_USE_RERANKER=true
#----MLFLOW----
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=healthcare-rag
